{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

    "pylint.importStrategy": "fromEnvironment",
    "pylint.lintOnChange": true,
    "pylint.args": [
        "--max-line-length=120",
        "--enable=redefined-builtin,import-error,invalid-name",
        "--confidence=HIGH"
    ],
    "pylint.severity": {
        "convention": "Information",
        "error": "Error",
        "fatal": "Error",
        "refactor": "Hint",
        "warning": "Warning"
    },

    "flake8.importStrategy": "fromEnvironment",
    "flake8.args": [
        "--max-line-length=120",
        "--extend-ignore=E501"
    ],
    "python-envs.pythonProjects": []
}
